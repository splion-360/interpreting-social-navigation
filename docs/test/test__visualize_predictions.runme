# Visualize Test Predictions

Generate one MP4 comparing the held-out MABe ground-truth future against a sampled model rollout.

Output path:

```text
outputs/visualizations/{graph_name}/{seq_id}.mp4
```

## Select a Test Trajectory

Leave `SEQ_ID = None` to use the first deterministic sequence in `mouse_triplet_test.npy`.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from data import MabeDataset

TEST_DATA = repo_root / "data/MaBe/mouse_triplet_test.npy"
SEQ_ID = 20


dataset = MabeDataset.from_file(TEST_DATA)
sequence_id = dataset.sequence_ids[SEQ_ID]
sequence = dataset.sequences[sequence_id]

print("sequence_id:", sequence_id)
print("keypoints:", sequence.keypoints.shape)
```

## Run Inference and Save Video

This samples future keypoint coordinates from the predicted bivariate Gaussian distribution. It does not use a deterministic mean rollout.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import load_test_config, save_test_prediction_video
from train import load_flat_fit_config

TRAIN_CONFIG = repo_root / "src/config/dense_keypoint__train.yml"
TEST_CONFIG = repo_root / "src/config/test.yml"
CHECKPOINT = repo_root / "checkpoints/dense_keypoint/flat_best.pt"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu" or "cuda" to override the train YAML device
train_config = load_flat_fit_config(TRAIN_CONFIG)
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)

result = save_test_prediction_video(
    config=train_config,
    test_config=test_config,
    checkpoint_path=CHECKPOINT,
    sequence_id=SEQ_ID,
    window_index=WINDOW_INDEX,
    output_root=repo_root / "outputs/visualizations",
    fps=8,
    interval_ms=120,
    seed=SEED,
)

print("sequence_id:", result.sequence_id)
print("start_frame:", result.start_frame)
print("graph:", result.graph_variant)
print("video:", result.path)
```

## Run Inference and Save Zoomed One-Mouse Video

This creates one MP4 with two adjacent panels: the actual mouse on the left and
the sampled model rollout on the right. Use `MOUSE_INDEX` to inspect one mouse
more closely.

Output path:

```text
outputs/visualizations/{graph_name}/{seq_id}__mouse_{mouse_index}.mp4
```

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import load_test_config, save_single_mouse_prediction_video
from train import load_flat_fit_config

TRAIN_CONFIG = repo_root / "src/config/dense_keypoint__train.yml"
TEST_CONFIG = repo_root / "src/config/test.yml"
CHECKPOINT = repo_root / "checkpoints/dense_keypoint/flat_best.pt"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
MOUSE_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu" or "cuda" to override the train YAML device

train_config = load_flat_fit_config(TRAIN_CONFIG)
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)

result = save_single_mouse_prediction_video(
    config=train_config,
    test_config=test_config,
    checkpoint_path=CHECKPOINT,
    mouse_index=MOUSE_INDEX,
    sequence_id=SEQ_ID,
    window_index=WINDOW_INDEX,
    output_root=repo_root / "outputs/visualizations",
    fps=8,
    interval_ms=120,
    seed=SEED,
)

print("sequence_id:", result.sequence_id)
print("start_frame:", result.start_frame)
print("graph:", result.graph_variant)
print("mouse_index:", MOUSE_INDEX)
print("video:", result.path)
```

## Print Exact-Window Error Profile

Use the same `SEQ_ID`, `WINDOW_INDEX`, and `SEED` as the generated video. This
prints metrics for the visualized rollout only, not the full sequence average.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import _sample_test_prediction, load_test_config, print_evaluation_metrics
from metric import compute_pixel_metrics
from train import load_flat_fit_config

TRAIN_CONFIG = repo_root / "src/config/dense_keypoint__train.yml"
TEST_CONFIG = repo_root / "src/config/test.yml"
CHECKPOINT = repo_root / "checkpoints/dense_keypoint/flat_best.pt"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu" or "cuda" to override the train YAML device

train_config = load_flat_fit_config(TRAIN_CONFIG)
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)

window, actual_keypoints, predicted_future = _sample_test_prediction(
    config=train_config,
    test_config=test_config,
    checkpoint_path=CHECKPOINT,
    sequence_id=SEQ_ID,
    window_index=WINDOW_INDEX,
    seed=SEED,
)
target_future = actual_keypoints[train_config.observation_length :]
metrics = compute_pixel_metrics(predicted_future, target_future).to_dict()

print("sequence_id:", window.sequence_id)
print("window_index:", WINDOW_INDEX)
print("start_frame:", window.start_frame)
print("prediction_frames:", predicted_future.shape[0])
print_evaluation_metrics(metrics)
```

## Notes

- The model receives normalized coordinates.
- The saved video is denormalized back to MABe pixel coordinates.
- Solid lines/points are ground truth. Dashed `x` markers are sampled predictions for future frames.
- Mouse labels use `0`, `1`, and `2` for ground truth and `p0`, `p1`, and `p2` for predicted mice in the triplet view.
