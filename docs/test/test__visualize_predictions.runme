# Visualize Test Predictions

Generate MP4s comparing held-out MABe ground-truth futures against sampled model
rollouts. Change `EXPERIMENT` to switch between trained variants without adding
new notebook sections.

The workflow follows the repo naming convention:

```text
src/config/train/{EXPERIMENT}.yml
checkpoints/{EXPERIMENT}/flat_best.pt
outputs/visualizations/{EXPERIMENT}/{seq_id}__{timestamp}.mp4
```

## Available trained variants

| Experiment | Use case |
| --- | --- |
| `flat_dense_triplet_5fps` | Dense keypoint graph over all three mice. |
| `flat_dense_single_mouse_5fps` | Dense keypoint graph over one mouse at a time. |

Add future variants to this table only. The cells below derive the train
configuration, checkpoint path, and output directory from `EXPERIMENT`.

## Inspect Experiment and Test Trajectory

Leave `SEQ_ID_OR_INDEX` as an integer to select by sorted test-sequence index,
or set it to a string sequence ID.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from data import MabeDataset, to_single_mouse_sequences
from evaluate import load_test_config
from train import load_flat_fit_config

EXPERIMENT = "flat_dense_single_mouse_5fps"
TEST_CONFIG = repo_root / "src/config/test/mabe.yml"
SEQ_ID_OR_INDEX = 20
DEVICE = "cuda"  # set to "cpu", "cuda", or None to use the train YAML device

train_config = load_flat_fit_config(repo_root / f"src/config/train/{EXPERIMENT}.yml")
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)
dataset = MabeDataset.from_file(test_config.data_path)
sequences = list(dataset.sequences.values())
if train_config.graph_variant == "single_mouse_dense_keypoint":
    sequences = to_single_mouse_sequences(sequences)
sequence_ids = [sequence.sequence_id for sequence in sequences]

sequence_id = (
    sequence_ids[SEQ_ID_OR_INDEX]
    if isinstance(SEQ_ID_OR_INDEX, int)
    else SEQ_ID_OR_INDEX
)
sequence = next(sequence for sequence in sequences if sequence.sequence_id == sequence_id)

print("experiment:", EXPERIMENT)
print("train_config:", repo_root / f"src/config/train/{EXPERIMENT}.yml")
print("checkpoint:", repo_root / f"checkpoints/{EXPERIMENT}/flat_best.pt")
print("sequence_id:", sequence_id)
print("keypoints:", sequence.keypoints.shape)
print("graph_variant:", train_config.graph_variant)
print("observed_frames:", train_config.observation_length)
print("predicted_frames:", train_config.prediction_length)
print("frame_step:", train_config.frame_step)
print("effective_fps:", train_config.source_fps / train_config.frame_step)
```

## Save Full Prediction Video

This samples future keypoint coordinates from the predicted bivariate Gaussian
distribution. It does not use a deterministic mean rollout.

For the triplet model, this shows all three mice. For the single-mouse model,
this shows the selected single-mouse sequence produced by that graph variant.
Set `SEQ_ID = None` to let the evaluator select the first compatible sequence
for the active variant.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
from datetime import datetime
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import load_test_config, save_test_prediction_video
from train import load_flat_fit_config

EXPERIMENT = "flat_dense_single_mouse_5fps"
TEST_CONFIG = repo_root / "src/config/test/mabe.yml"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu", "cuda", or None to use the train YAML device
RUN_TIMESTAMP = datetime.now().strftime("%Y%m%d_%H%M%S")

train_config = load_flat_fit_config(repo_root / f"src/config/train/{EXPERIMENT}.yml")
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)

result = save_test_prediction_video(
    config=train_config,
    test_config=test_config,
    checkpoint_path=repo_root / f"checkpoints/{EXPERIMENT}/flat_best.pt",
    sequence_id=SEQ_ID,
    window_index=WINDOW_INDEX,
    output_root=repo_root / f"outputs/visualizations/{EXPERIMENT}",
    fps=8,
    interval_ms=120,
    seed=SEED,
    filename_suffix=f"__{RUN_TIMESTAMP}",
)

print("experiment:", EXPERIMENT)
print("sequence_id:", result.sequence_id)
print("start_frame:", result.start_frame)
print("graph:", result.graph_variant)
print("observed_frames:", train_config.observation_length)
print("predicted_frames:", train_config.prediction_length)
print("frame_step:", train_config.frame_step)
print("effective_fps:", train_config.source_fps / train_config.frame_step)
print("video:", result.path)
```

## Save Zoomed One-Mouse Video

This creates one MP4 for a selected mouse with two adjacent panels: the actual
mouse on the left and the sampled model rollout on the right.

Use `MOUSE_INDEX = 0` for the single-mouse experiment.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
from datetime import datetime
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import load_test_config, save_single_mouse_prediction_video
from train import load_flat_fit_config

EXPERIMENT = "flat_dense_single_mouse_5fps"
TEST_CONFIG = repo_root / "src/config/test/mabe.yml"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
MOUSE_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu", "cuda", or None to use the train YAML device
RUN_TIMESTAMP = datetime.now().strftime("%Y%m%d_%H%M%S")

train_config = load_flat_fit_config(repo_root / f"src/config/train/{EXPERIMENT}.yml")
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)

result = save_single_mouse_prediction_video(
    config=train_config,
    test_config=test_config,
    checkpoint_path=repo_root / f"checkpoints/{EXPERIMENT}/flat_best.pt",
    mouse_index=MOUSE_INDEX,
    sequence_id=SEQ_ID,
    window_index=WINDOW_INDEX,
    output_root=repo_root / f"outputs/visualizations/{EXPERIMENT}",
    fps=8,
    interval_ms=120,
    seed=SEED,
    filename_suffix=f"__{RUN_TIMESTAMP}",
)

print("experiment:", EXPERIMENT)
print("sequence_id:", result.sequence_id)
print("start_frame:", result.start_frame)
print("graph:", result.graph_variant)
print("mouse_index:", MOUSE_INDEX)
print("observed_frames:", train_config.observation_length)
print("predicted_frames:", train_config.prediction_length)
print("frame_step:", train_config.frame_step)
print("effective_fps:", train_config.source_fps / train_config.frame_step)
print("video:", result.path)
```

## Save Zoomed Videos for Every Available Mouse

This creates one zoomed MP4 per available mouse. Triplet experiments generate
three files; single-mouse experiments generate one file.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
from datetime import datetime
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import load_test_config, save_single_mouse_prediction_video
from train import load_flat_fit_config

EXPERIMENT = "flat_dense_single_mouse_5fps"
TEST_CONFIG = repo_root / "src/config/test/mabe.yml"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu", "cuda", or None to use the train YAML device
RUN_TIMESTAMP = datetime.now().strftime("%Y%m%d_%H%M%S")

train_config = load_flat_fit_config(repo_root / f"src/config/train/{EXPERIMENT}.yml")
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)
mouse_indices = range(1 if train_config.graph_variant == "single_mouse_dense_keypoint" else 3)

for mouse_index in mouse_indices:
    result = save_single_mouse_prediction_video(
        config=train_config,
        test_config=test_config,
        checkpoint_path=repo_root / f"checkpoints/{EXPERIMENT}/flat_best.pt",
        mouse_index=mouse_index,
        sequence_id=SEQ_ID,
        window_index=WINDOW_INDEX,
        output_root=repo_root / f"outputs/visualizations/{EXPERIMENT}",
        fps=8,
        interval_ms=120,
        seed=SEED,
        filename_suffix=f"__{RUN_TIMESTAMP}",
    )

    print("experiment:", EXPERIMENT)
    print("sequence_id:", result.sequence_id)
    print("start_frame:", result.start_frame)
    print("graph:", result.graph_variant)
    print("mouse_index:", mouse_index)
    print("observed_frames:", train_config.observation_length)
    print("predicted_frames:", train_config.prediction_length)
    print("frame_step:", train_config.frame_step)
    print("effective_fps:", train_config.source_fps / train_config.frame_step)
    print("video:", result.path)
    print()
```

## Print Exact-Window Error Profile

Use the same `EXPERIMENT`, `SEQ_ID`, `WINDOW_INDEX`, and `SEED` as the generated
video. This prints metrics for the visualized rollout only, not the full
benchmark average.

```python {"interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python"}
from dataclasses import replace
import os
from pathlib import Path
import sys

repo_root = next(path for path in [Path.cwd(), *Path.cwd().parents] if (path / "src").exists())
os.environ.setdefault("MPLCONFIGDIR", str(repo_root / "outputs/matplotlib"))
sys.path.insert(0, str(repo_root / "src"))

from evaluate import _sample_test_prediction, load_test_config, print_evaluation_metrics
from metrics import compute_pixel_metrics
from train import load_flat_fit_config

EXPERIMENT = "flat_dense_single_mouse_5fps"
TEST_CONFIG = repo_root / "src/config/test/mabe.yml"
SEQ_ID = "07FMZMD2TNPY7W3W48KA"
WINDOW_INDEX = 0
SEED = 42
DEVICE = "cuda"  # set to "cpu", "cuda", or None to use the train YAML device

train_config = load_flat_fit_config(repo_root / f"src/config/train/{EXPERIMENT}.yml")
if DEVICE is not None:
    train_config = replace(train_config, device=DEVICE)
test_config = load_test_config(TEST_CONFIG)

window, actual_keypoints, predicted_future = _sample_test_prediction(
    config=train_config,
    test_config=test_config,
    checkpoint_path=repo_root / f"checkpoints/{EXPERIMENT}/flat_best.pt",
    sequence_id=SEQ_ID,
    window_index=WINDOW_INDEX,
    seed=SEED,
)
target_future = actual_keypoints[train_config.observation_length :]
metrics = compute_pixel_metrics(predicted_future, target_future).to_dict()

print("experiment:", EXPERIMENT)
print("sequence_id:", window.sequence_id)
print("window_index:", WINDOW_INDEX)
print("start_frame:", window.start_frame)
print("observed_frames:", train_config.observation_length)
print("prediction_frames:", predicted_future.shape[0])
print("frame_step:", train_config.frame_step)
print("effective_fps:", train_config.source_fps / train_config.frame_step)
print_evaluation_metrics(metrics)
```

## Notes

- The model receives normalized coordinates.
- The saved video is denormalized back to MABe pixel coordinates.
- Solid lines/points are ground truth. Dashed `x` markers are sampled predictions for future frames.
- Mouse labels use `0`, `1`, and `2` for ground truth and `p0`, `p1`, and `p2` for predicted mice in triplet views.
