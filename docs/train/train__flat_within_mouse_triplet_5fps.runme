## Compare experiment records

Run this after the dense triplet, single-mouse, and within-mouse benchmark
records exist. It prints the latest overall metrics from each experiment so the
cross-mouse edge ablation can be read side by side.

```python {"id":"01M25WITHINMOUSE5FPSCOMPARE","interpreter":"/home/splion/Desktop/personal/interpreting-social-navigation/.venv/bin/python3.13"}
from __future__ import annotations

import json
from pathlib import Path

from rich.console import Console
from rich.table import Table


records = {
    "flat_dense_triplet_5fps": Path(
        "outputs/evaluations/flat_dense_triplet_5fps/benchmark_16_24/results.jsonl"
    ),
    "flat_dense_single_mouse_5fps": Path(
        "outputs/evaluations/flat_dense_single_mouse_5fps/benchmark_16_24/results.jsonl"
    ),
    "flat_within_mouse_triplet_5fps": Path(
        "outputs/evaluations/flat_within_mouse_triplet_5fps/benchmark_16_24/results.jsonl"
    ),
}

metric_names = (
    "centroid_ade_px",
    "centroid_fde_px",
    "body_heading_error_deg",
    "body_frame_keypoint_ade_px",
    "body_frame_keypoint_fde_px",
    "relative_ordering_error",
)

table = Table(title="Latest 5 FPS experiment comparison")
table.add_column("experiment", style="cyan")
table.add_column("method")
for metric_name in metric_names:
    table.add_column(metric_name, justify="right")

for experiment, path in records.items():
    if not path.exists():
        table.add_row(experiment, "missing", *("-" for _ in metric_names))
        continue

    lines = [line for line in path.read_text().splitlines() if line.strip()]
    record = json.loads(lines[-1])
    for method_name, method in record["methods"].items():
        metrics = method["metrics"]
        table.add_row(
            experiment,
            method_name,
            *(f"{metrics[name]:.3f}" for name in metric_names),
        )

Console().print(table)
```

